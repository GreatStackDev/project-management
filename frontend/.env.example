# Copy to .env and fill in. Both are public by design: Vite inlines VITE_* values into the browser bundle,
# so never put a secret here.

# Clerk Dashboard -> API keys -> Publishable key (pk_test_... or pk_live_...)
VITE_CLERK_PUBLISHABLE_KEY=

# The backend's base URL, no trailing slash (e.g. http://localhost:3000 locally)
VITE_BASE_URL=
